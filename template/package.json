{
  "name": "my-bot-modules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "guildwright start",
    "dev": "node --watch node_modules/guildwright/dist/cli.js start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "scaffold": "guildwright scaffold",
    "doctor": "guildwright doctor"
  },
  "dependencies": {
    "guildwright": "<version>",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "imports": {
    "#core/*": "guildwright/core/*",
    "#modules/*": "./src/modules/*.ts",
    "#testing/*": "guildwright/testing/*"
  }
}
